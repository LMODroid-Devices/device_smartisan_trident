typeattribute tee data_between_core_and_vendor_violators;

allow tee fingerprintd_data_file:dir create_dir_perms;
allow tee fingerprintd_data_file:file create_file_perms;

allow tee fingerprint_data_file:dir { add_name open read remove_name search write };
allow tee fingerprint_data_file:file { create open read unlink write };

allow tee mnt_vendor_file:dir create_dir_perms;
allow tee mnt_vendor_file:file create_file_perms;
