typeattribute hal_fingerprint_default data_between_core_and_vendor_violators;

r_dir_file(hal_fingerprint_default, persist_fingerprint_file)

allow hal_fingerprint_default fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default fingerprint_data_file:dir { create write };
allow hal_fingerprint_default fingerprint_data_file:file create_file_perms;
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_default sysfs_fingerprint:dir r_dir_perms;
allow hal_fingerprint_default sysfs_fingerprint:file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;
allow hal_fingerprint_default input_device:dir r_dir_perms;
allow hal_fingerprint_default input_device:chr_file rw_file_perms;

allow hal_fingerprint_default sysfs_graphics:dir search;
allow hal_fingerprint_default sysfs_graphics:file r_file_perms;

allow hal_fingerprint_default fingerprintd_data_file:dir rw_dir_perms;
allow hal_fingerprint_default fingerprintd_data_file:file create_file_perms;

allow hal_fingerprint_default persist_fingerprint_file:dir { add_name remove_name search write };
allow hal_fingerprint_default persist_fingerprint_file:file { create getattr open read unlink write };

allow hal_fingerprint_default mnt_vendor_file:dir { add_name remove_name search write };
allow hal_fingerprint_default mnt_vendor_file:file { create getattr open read unlink write };

allow hal_fingerprint_default sysfs:file write;

allow hal_fingerprint_default sysfs_uio:dir { open read search };
allow hal_fingerprint_default sysfs_uio:lnk_file read;

allow hal_fingerprint_default sysfs_uio_file:dir search;
allow hal_fingerprint_default sysfs_uio_file:file { getattr open read };

get_prop(hal_fingerprint_default, vendor_fp_prop)
set_prop(hal_fingerprint_default, vendor_fp_prop)
hal_client_domain(hal_fingerprint_default, hal_perf)

# Ignore all logging requests
dontaudit hal_fingerprint storage_file:dir search;
